<ui:FluentWindow x:Class="CsvAnalyser.App.ExportWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:CsvAnalyser.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:ExportViewModel}"
                 Title="Exporter en CSV"
                 Width="480"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Exporter en CSV" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,0">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Lignes" />
            <ComboBox Margin="0,0,0,16"
                      ItemsSource="{Binding RangeChoices}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="Label"
                      SelectedValue="{Binding Range}" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="Colonnes" />
            <ComboBox ItemsSource="{Binding ColumnChoices}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="Label"
                      SelectedValue="{Binding PlottedOnly}" />
            <TextBlock Margin="0,4,0,16" Foreground="{DynamicResource AppSecondaryTextBrush}" TextWrapping="Wrap"
                       Text="Les en-têtes reprennent les noms et unités affichés, par exemple « Courant [A] »." />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Séparateur de colonnes" />
                    <ComboBox ItemsSource="{x:Static vm:ExportViewModel.DelimiterChoices}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              SelectedValue="{Binding Delimiter}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Décimale" />
                    <ComboBox ItemsSource="{x:Static vm:ExportViewModel.DecimalChoices}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              SelectedValue="{Binding Decimal}" />
                </StackPanel>
            </Grid>

            <CheckBox Margin="0,0,0,12"
                      Content="Ajouter une colonne avec la date et l'heure de chaque ligne"
                      IsChecked="{Binding IncludeDate}"
                      Visibility="{Binding CanIncludeDate, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Foreground="{DynamicResource AppSecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding Summary}" />
            <TextBlock Margin="0,6,0,0" Foreground="#D13438" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="24,16,24,20" LastChildFill="False">
            <ui:Button DockPanel.Dock="Right"
                       MinWidth="110"
                       Margin="8,0,0,0"
                       Appearance="Primary"
                       Content="Exporter…"
                       Icon="{ui:SymbolIcon Save24}"
                       IsDefault="True"
                       IsEnabled="{Binding CanExport}"
                       Click="OnExport" />
            <ui:Button DockPanel.Dock="Right"
                       MinWidth="100"
                       Content="Annuler"
                       IsCancel="True" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
