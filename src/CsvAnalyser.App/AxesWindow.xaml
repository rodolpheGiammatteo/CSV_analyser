<ui:FluentWindow x:Class="CsvAnalyser.App.AxesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:CsvAnalyser.App.ViewModels"
                 Title="Axes"
                 Width="640"
                 SizeToContent="Height"
                 MaxHeight="760"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowCornerPreference="Round">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Axes" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,12">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Axes Y" />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}"
                       Text="Automatique : l'axe s'ajuste aux courbes visibles (bouton Ajuster, clic molette). Manuel : ces bornes sont reprises à chaque ajustement ; le zoom à la souris reste possible." />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}"
                       Text="Dans un graphe, les courbes de même unité partagent un axe. Pour donner un axe à part à une courbe : Réglages de la courbe → Axe Y séparé." />
        </StackPanel>

        <ScrollViewer Grid.Row="2" x:Name="Scroller" Margin="24,0,12,0" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GraphList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GraphAxesViewModel}">
                        <Border Margin="0,0,0,12" Padding="14,10" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource AppDisabledTextBrush}">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right"
                                              Content="Aligner les zéros"
                                              ToolTip="Le zéro de chaque axe Y est placé à la même hauteur"
                                              IsChecked="{Binding Graph.AlignZeros}"
                                              IsEnabled="{Binding CanAlignZeros}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding Graph.Title}" />
                                </DockPanel>
                                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource AppSecondaryTextBrush}" Text="Aucune courbe"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Axes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AxisRowViewModel}">
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Width="4" Margin="0,2,10,2" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Label, Mode=OneWay}" />
                                                        <Run Foreground="{DynamicResource AppSecondaryTextBrush}" FontWeight="Normal" Text="{Binding Side, StringFormat=— à {0}, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Foreground="{DynamicResource AppSecondaryTextBrush}" TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Curves}" ToolTip="{Binding Curves}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="12,0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <RadioButton MinWidth="0" Margin="0,0,8,0" Content="Auto" IsChecked="{Binding Settings.IsAuto}" />
                                                    <RadioButton MinWidth="0" Content="Manuel" IsChecked="{Binding Settings.IsManual}" />
                                                </StackPanel>
                                                <!-- Not disabled in auto mode (disabled WPF-UI boxes are invisible here): typing a bound switches to manual. -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:TextBox Width="96" PlaceholderText="min" ToolTip="Minimum (Entrée pour appliquer)"
                                                                    Text="{Binding Settings.MinText}" KeyDown="OnBoundKeyDown" />
                                                        <ui:TextBox Width="96" Margin="6,0,0,0" PlaceholderText="max" ToolTip="Maximum (Entrée pour appliquer)"
                                                                    Text="{Binding Settings.MaxText}" KeyDown="OnBoundKeyDown" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,2,0,0" Foreground="#D13438" Text="Bornes invalides (min &lt; max)"
                                                               Visibility="{Binding Settings.HasError, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="24,8,24,20" LastChildFill="False">
            <ui:Button DockPanel.Dock="Right"
                       MinWidth="100"
                       Appearance="Primary"
                       Content="Fermer"
                       IsCancel="True"
                       Click="OnClose" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
