<ui:FluentWindow x:Class="CsvAnalyser.App.AxesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:CsvAnalyser.App.ViewModels"
                 xmlns:controls="clr-namespace:CsvAnalyser.App.Controls"
                 Title="Graphes et axes"
                 Width="920"
                 SizeToContent="Height"
                 MaxHeight="880"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
        </Style>
        <Style x:Key="IconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Padding" Value="5" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- Color square of a curve: opens the color palette. -->
        <Style x:Key="ColorButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="4" BorderThickness="1" Padding="2"
                                BorderBrush="{DynamicResource AppDisabledTextBrush}" Background="Transparent">
                            <Border CornerRadius="2" Background="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AppSecondaryTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Graphes et axes" ShowMinimize="False" ShowMaximize="False" />

        <DockPanel Grid.Row="1" Margin="24,0,24,12" LastChildFill="False">
            <ui:Button DockPanel.Dock="Left"
                       Appearance="Primary"
                       Content="Nouveau graphe"
                       Icon="{ui:SymbolIcon Add24}"
                       Click="OnAddGraph" />
            <ComboBox DockPanel.Dock="Right" Width="140"
                      ToolTip="Disposition des graphes"
                      ItemsSource="{x:Static vm:MainViewModel.GraphColumnChoices}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="Label"
                      SelectedValue="{Binding GraphColumns}" />
        </DockPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="2" Margin="24,0,12,0" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GraphList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GraphAxesViewModel}">
                        <Border Margin="0,0,0,12" Padding="16,12" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource AppDisabledTextBrush}">
                            <StackPanel>
                                <!-- Graphe : numéro, titre, hauteur, ordre, suppression -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                               Text="{Binding Graph.NumberLabel}" />
                                    <ui:TextBox Grid.Column="1"
                                                PlaceholderText="Titre du graphe"
                                                Text="{Binding Graph.Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="2" Width="95" Margin="8,0,0,0"
                                              ToolTip="Hauteur du graphe"
                                              ItemsSource="{x:Static vm:GraphViewModel.HeightChoices}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="Label"
                                              SelectedValue="{Binding Graph.HeightFactor}" />
                                    <StackPanel Grid.Column="3" Margin="6,0,0,0" Orientation="Horizontal">
                                        <!-- Hidden rather than disabled: disabled WPF-UI buttons are invisible here. -->
                                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowUp24}" ToolTip="Monter le graphe"
                                                   Visibility="{Binding CanMoveUp, Converter={StaticResource BoolToVisibility}}" Click="OnMoveUp" />
                                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowDown24}" ToolTip="Descendre le graphe"
                                                   Visibility="{Binding CanMoveDown, Converter={StaticResource BoolToVisibility}}" Click="OnMoveDown" />
                                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Delete24}" ToolTip="Supprimer le graphe"
                                                   Click="OnRemoveGraph" />
                                    </StackPanel>
                                </Grid>

                                <DockPanel Margin="90,8,0,0" LastChildFill="False">
                                    <ComboBox DockPanel.Dock="Right" Width="190"
                                              ToolTip="Légende (on peut aussi la faire glisser sur le graphe)"
                                              ItemsSource="{x:Static vm:GraphViewModel.LegendChoices}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="Label"
                                              SelectedValue="{Binding Graph.LegendCorner}" />
                                    <TextBlock DockPanel.Dock="Right" Margin="0,0,10,0" VerticalAlignment="Center" Text="Légende" />
                                    <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"
                                              Content="Aligner les axes Y"
                                              ToolTip="Les valeurs de référence des axes (0 par défaut, réglables ci-dessous) sont à la même hauteur"
                                              IsChecked="{Binding Graph.AlignZeros}"
                                              Visibility="{Binding CanAlignZeros, Converter={StaticResource BoolToVisibility}}" />
                                </DockPanel>

                                <!-- Courbes -->
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Courbes" />
                                <ItemsControl ItemsSource="{Binding Curves}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GraphCurveRow}">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="210" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <ui:Button Style="{StaticResource IconButton}" Margin="0" Icon="{ui:SymbolIcon ChevronUp20}"
                                                               ToolTip="Dessiner en dessous (plus haut dans la liste)"
                                                               Visibility="{Binding CanMoveUp, Converter={StaticResource BoolToVisibility}}" Click="OnCurveUp" />
                                                    <ui:Button Style="{StaticResource IconButton}" Margin="0" Icon="{ui:SymbolIcon ChevronDown20}"
                                                               ToolTip="Dessiner par-dessus (plus bas dans la liste)"
                                                               Visibility="{Binding CanMoveDown, Converter={StaticResource BoolToVisibility}}" Click="OnCurveDown" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource ColorButton}" HorizontalAlignment="Left"
                                                        Background="{Binding Item.Brush}" ToolTip="Couleur" Click="OnColorClick" />
                                                <TextBlock Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Item.LegendText}" ToolTip="{Binding Item.LegendText}" />
                                                <ComboBox Grid.Column="3" Margin="0,0,6,0"
                                                          ToolTip="Axe Y de la courbe"
                                                          ItemsSource="{Binding AxisChoices}"
                                                          SelectedValuePath="Value"
                                                          DisplayMemberPath="Label"
                                                          SelectedValue="{Binding Item.AxisChoice}" />
                                                <ComboBox Grid.Column="4"
                                                          ToolTip="Graphe"
                                                          ItemsSource="{Binding Choices}"
                                                          DisplayMemberPath="Label"
                                                          SelectedItem="{Binding Selected}" />
                                                <StackPanel Grid.Column="5" Margin="4,0,0,0" Orientation="Horizontal">
                                                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Settings24}"
                                                               ToolTip="Tous les réglages : nom, unité, trait, points, opacité" Click="OnCurveSettings" />
                                                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}"
                                                               ToolTip="Masquer la courbe" Click="OnHideCurve" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Same columns as the curve rows: starts under the color squares, ends where the axis lists start. -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <controls:SearchPicker Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,8,0"
                                                           ItemsSource="{Binding AllCurves}"
                                                           DisplayMemberPath="LegendText"
                                                           Placeholder="＋ Ajouter une courbe…"
                                                           KeepSelection="False"
                                                           Picked="OnAddCurve" />
                                </Grid>

                                <!-- Axes Y -->
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Axes Y"
                                           Visibility="{Binding HasAxes, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Axes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AxisRowViewModel}">
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Width="4" HorizontalAlignment="Left" Margin="0,4" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" />
                                                <ui:TextBox Grid.Column="1" Margin="0,0,6,0"
                                                            PlaceholderText="{Binding AutoLabel}"
                                                            ToolTip="{Binding Description}"
                                                            Text="{Binding Settings.Title, UpdateSourceTrigger=LostFocus}" KeyDown="OnBoundKeyDown" />
                                                <ComboBox Grid.Column="2" Margin="0,0,10,0"
                                                          ToolTip="Côté de l'axe (auto : alterné gauche / droite)"
                                                          ItemsSource="{x:Static vm:AxisRangeSettings.SideChoices}"
                                                          SelectedValuePath="Value"
                                                          DisplayMemberPath="Label"
                                                          SelectedValue="{Binding Settings.Side}" />
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <RadioButton MinWidth="0" Margin="0,0,8,0" Content="Auto" IsChecked="{Binding Settings.IsAuto}" />
                                                    <RadioButton MinWidth="0" Content="Manuel" IsChecked="{Binding Settings.IsManual}" />
                                                </StackPanel>
                                                <!-- Never disabled (disabled WPF-UI boxes are invisible here): typing a bound switches to manual. -->
                                                <StackPanel Grid.Column="4" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:TextBox Width="88" PlaceholderText="min" ToolTip="Minimum (Entrée pour appliquer)"
                                                                    Text="{Binding Settings.MinText}" KeyDown="OnBoundKeyDown" />
                                                        <ui:TextBox Width="88" Margin="6,0,0,0" PlaceholderText="max" ToolTip="Maximum (Entrée pour appliquer)"
                                                                    Text="{Binding Settings.MaxText}" KeyDown="OnBoundKeyDown" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,2,0,0" Foreground="#D13438" Text="min doit être &lt; max"
                                                               Visibility="{Binding Settings.HasError, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="5" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center"
                                                            ToolTip="Valeur de cet axe placée à la même hauteur que celle des autres axes (ex. 1000 mbar absolu avec 0 mbar relatif)"
                                                            Visibility="{Binding DataContext.ShowAlignValues, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="aligné sur" />
                                                    <ui:TextBox Width="70" Text="{Binding Settings.AlignValueText}" KeyDown="OnBoundKeyDown" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="24,8,24,20" LastChildFill="False">
            <ui:Button DockPanel.Dock="Right"
                       MinWidth="100"
                       Appearance="Primary"
                       Content="Fermer"
                       IsCancel="True"
                       Click="OnClose" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
