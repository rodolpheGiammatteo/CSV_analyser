<ui:FluentWindow x:Class="CsvAnalyser.App.ComputedCurveWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:CsvAnalyser.App.ViewModels"
                 xmlns:controls="clr-namespace:CsvAnalyser.App.Controls"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:ComputedCurveViewModel}"
                 Title="{Binding Title}"
                 Width="560"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 controls:UiScaling.ScaleWindow="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,0">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Calcul" />
            <ComboBox ItemsSource="{x:Static vm:ComputedCurveViewModel.KindChoices}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="Label"
                      SelectedValue="{Binding Kind}" />

            <!-- Formule -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsFormula, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="0,0,0,6">
                    <controls:SearchPicker DockPanel.Dock="Right" Width="240"
                                           ItemsSource="{Binding Curves}"
                                           DisplayMemberPath="LegendText"
                                           Placeholder="Insérer une courbe…"
                                           KeepSelection="False"
                                           ToolTip="Insère la courbe choisie dans la formule, à la position du curseur"
                                           Picked="OnInsertCurve" />
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Formule" />
                </DockPanel>
                <TextBox x:Name="ExpressionBox"
                         MinHeight="64"
                         FontFamily="Consolas"
                         AcceptsReturn="False"
                         TextWrapping="Wrap"
                         Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Help}" FontFamily="Consolas" Text="{Binding FormulaCheck}" />
                <!-- Aide sur l'écriture des formules -->
                <Border Margin="0,10,0,0" Padding="14,10" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource AppDisabledTextBrush}">
                    <Grid>
                        <Grid.Resources>
                            <Style x:Key="Term" TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,3,16,3" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                            </Style>
                            <Style x:Key="Code" TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,3,0,3" />
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                            <Style x:Key="Note" TargetType="Run">
                                <Setter Property="FontFamily" Value="Segoe UI" />
                                <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource Term}" Text="Courbes" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Code}">
                            <Run Text="[Nom de la courbe]" /><Run Style="{StaticResource Note}" Text="   entre crochets (ou « Insérer une courbe »)" />
                        </TextBlock>

                        <TextBlock Grid.Row="1" Style="{StaticResource Term}" Text="Opérations" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Code}">
                            <Run Text="+  -  *  /  ^  ( )" /><Run Style="{StaticResource Note}" Text="   ^ = puissance" />
                        </TextBlock>

                        <TextBlock Grid.Row="2" Style="{StaticResource Term}" Text="Comparaisons" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Code}">
                            <Run Text="&lt;  &gt;  &lt;=  &gt;=  ==  !=" /><Run Style="{StaticResource Note}" Text="   donnent 1 si vrai, 0 sinon" />
                        </TextBlock>

                        <TextBlock Grid.Row="3" Style="{StaticResource Term}" Text="Condition" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Code}" Text="if(condition ; si vrai ; si faux)" />

                        <TextBlock Grid.Row="4" Style="{StaticResource Term}" Text="Fonctions" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Code}"
                                   Text="abs  sqrt  exp  ln  log10  sin  cos  tan  asin  acos  atan  atan2  pow  min  max  round  floor  ceil  sign" />

                        <TextBlock Grid.Row="5" Style="{StaticResource Term}" Text="Valeurs" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Code}">
                            <Run Text="t" /><Run Style="{StaticResource Note}" Text=" = temps   " /><Run Text="pi  e" /><Run Style="{StaticResource Note}" Text="   décimales avec un point : " /><Run Text="1.5" />
                        </TextBlock>

                        <TextBlock Grid.Row="6" Style="{StaticResource Term}" Text="Arguments" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Code}">
                            <Run Text="max([A] ; [B])" /><Run Style="{StaticResource Note}" Text="   séparés par ; ou ," />
                        </TextBlock>

                        <TextBlock Grid.Row="7" Margin="0,8,16,3" Style="{StaticResource Term}" Text="Exemples" />
                        <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,5,0,0">
                            <TextBlock Style="{StaticResource Code}">
                                <Run Text="[Courant] * [Tension] / 1000" /><Run Style="{StaticResource Note}" Text="   puissance en kW" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Code}">
                                <Run Text="sqrt([X]^2 + [Y]^2)" /><Run Style="{StaticResource Note}" Text="   norme" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Code}">
                                <Run Text="if([P] &gt; 0 ; [P] ; 0)" /><Run Style="{StaticResource Note}" Text="   valeurs négatives mises à 0" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Filtres -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsFilter, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Courbe à traiter" />
                <controls:SearchPicker ItemsSource="{Binding Curves}"
                                       DisplayMemberPath="LegendText"
                                       Placeholder="Choisir une courbe…"
                                       SelectedItem="{Binding Source}" />
                <TextBlock Style="{StaticResource Help}" Text="{Binding KindHelp}" />
                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasParameter, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding ParameterLabel}" />
                    <ui:TextBox Width="160" HorizontalAlignment="Left"
                                Text="{Binding ParameterText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <CheckBox Margin="0,10,0,0"
                          Content="Sans déphasage (filtre appliqué dans les deux sens)"
                          ToolTip="La courbe filtrée n'est pas décalée dans le temps, et la pente du filtre est doublée"
                          IsChecked="{Binding ZeroPhase}"
                          Visibility="{Binding HasZeroPhase, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Nom et unité -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Nom de la nouvelle courbe" />
                    <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Unité" />
                    <ui:TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
            <TextBlock Margin="0,10,0,0" Foreground="#D13438" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="24,12,24,20" LastChildFill="False">
            <ui:Button DockPanel.Dock="Right"
                       MinWidth="110"
                       Margin="8,0,0,0"
                       Appearance="Primary"
                       Content="{Binding OkText}"
                       Icon="{ui:SymbolIcon MathFormula24}"
                       IsDefault="True"
                       Click="OnOk" />
            <ui:Button DockPanel.Dock="Right"
                       MinWidth="100"
                       Content="Annuler"
                       IsCancel="True" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
