<ui:FluentWindow x:Class="CsvAnalyser.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
                 xmlns:vm="clr-namespace:CsvAnalyser.App.ViewModels"
                 xmlns:controls="clr-namespace:CsvAnalyser.App.Controls"
                 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="{Binding Title}"
                 Width="1400" Height="860" MinWidth="900" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowCornerPreference="Round"
                 Icon="Assets/app.ico"
                 AllowDrop="True"
                 DragOver="OnDragOver"
                 DragLeave="OnWindowDragLeave"
                 Drop="OnDrop">
    <ui:FluentWindow.Resources>
        <!-- Undo/redo stay enabled; Tag = "something to undo". The WPF-UI disabled look is semi-transparent,
             which renders invisible here, so "nothing to undo" is shown with an opaque gray instead. -->
        <Style x:Key="HistoryButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value>
                        <sys:Boolean>False</sys:Boolean>
                    </Trigger.Value>
                    <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Right-click on the fit buttons (one copy per button). -->
    </ui:FluentWindow.Resources>
    <ui:FluentWindow.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoViewCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoViewCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="Z" Command="{Binding RedoViewCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveProjectAsCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="E" Command="{Binding ExportCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="M" Command="{Binding ToggleMeasureCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="M" Command="{Binding ToggleMeasureYCommand}" />
    </ui:FluentWindow.InputBindings>
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-64.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Barre d'outils : "Paramètres" à droite, le reste passe à la ligne si la fenêtre est étroite -->
        <DockPanel Grid.Row="1" Margin="12,4,12,10">
            <DockPanel.LayoutTransform>
                <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
            </DockPanel.LayoutTransform>
            <ui:Button DockPanel.Dock="Right"
                       VerticalAlignment="Top"
                       Margin="8,0,0,0"
                       Content="Paramètres"
                       Icon="{ui:SymbolIcon Settings24}"
                       Click="OnOpenSettings" />
            <WrapPanel>
                <WrapPanel.Resources>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Margin" Value="4,2,0,2" />
                    </Style>
                </WrapPanel.Resources>
                <ui:Button x:Name="CurveListButton"
                           Margin="0,2,8,2"
                           Icon="{ui:SymbolIcon PanelLeftContract24}"
                           ToolTip="Masquer ou afficher la liste des courbes (Ctrl+L)"
                           Click="OnToggleCurveList" />
                <ui:Button Margin="0,2,0,2"
                           Appearance="Primary"
                           Content="Ouvrir…"
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           ToolTip="Ouvrir un fichier CSV ou un projet (Ctrl+O)"
                           Command="{Binding OpenCommand}" />
                <ui:Button Icon="{ui:SymbolIcon History24}"
                           ToolTip="Ouvrir un fichier récent"
                           Click="OnRecentMenu" />
                <ui:Button Icon="{ui:SymbolIcon Save24}"
                           ToolTip="Projet (fichier CSV + mise en page) : enregistrer, ouvrir ; appliquer une mise en page ; exporter en CSV"
                           Click="OnOpenButtonMenu">
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Enregistrer le projet" InputGestureText="Ctrl+S"
                                      Icon="{ui:SymbolIcon Save24}"
                                      Command="{Binding SaveProjectCommand}" />
                            <MenuItem Header="Enregistrer le projet sous…" InputGestureText="Ctrl+Maj+S"
                                      Icon="{ui:SymbolIcon SaveEdit24}"
                                      Command="{Binding SaveProjectAsCommand}" />
                            <MenuItem Header="Ouvrir un projet…"
                                      Icon="{ui:SymbolIcon FolderOpen24}"
                                      Command="{Binding OpenProjectCommand}" />
                            <MenuItem Header="Ouvrir l'emplacement du fichier"
                                      ToolTip="Ouvre l'Explorateur sur le dossier du fichier CSV"
                                      Icon="{ui:SymbolIcon Folder24}"
                                      Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}"
                                      Command="{Binding ShowFileInExplorerCommand}" />
                            <MenuItem Header="Ouvrir l'emplacement du projet"
                                      ToolTip="Ouvre l'Explorateur sur le dossier du fichier projet"
                                      Icon="{ui:SymbolIcon Folder24}"
                                      Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}"
                                      Command="{Binding ShowProjectInExplorerCommand}" />
                            <Separator />
                            <MenuItem Header="Appliquer une mise en page au fichier ouvert…"
                                      Icon="{ui:SymbolIcon DocumentArrowLeft24}"
                                      Command="{Binding OpenConfigurationCommand}" />
                            <Separator />
                            <MenuItem Header="Exporter en CSV…" InputGestureText="Ctrl+E"
                                      Icon="{ui:SymbolIcon ArrowExportLtr24}"
                                      Command="{Binding ExportCommand}" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
                <StackPanel Margin="16,2,0,2" Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Axe X" />
                    <controls:SearchPicker Width="220"
                                           ItemsSource="{Binding XAxisOptions}"
                                           DisplayMemberPath="Label"
                                           SelectedItem="{Binding SelectedXAxis}"
                                           IsEnabled="{Binding HasData}" />
                </StackPanel>
                <ui:Button Margin="12,2,0,2"
                           Content="Ajuster"
                           Icon="{ui:SymbolIcon ArrowMaximize24}"
                           ToolTip="Tout ajuster : X sur l'ensemble des données, Y de tous les graphes, axes manuels compris (aussi : clic molette). Clic droit : tout remettre en automatique et ajuster"
                           Command="{Binding AutoScaleCommand}">
                    <ui:Button.InputBindings>
                        <MouseBinding MouseAction="RightClick" Command="{Binding AutoAllAxesCommand}" CommandParameter="xy" />
                    </ui:Button.InputBindings>
                </ui:Button>
                <ui:Button Icon="{ui:SymbolIcon ArrowAutofitWidth24}"
                           ToolTip="Ajuster X seulement (le zoom vertical est gardé). Clic droit : tout remettre en automatique et ajuster"
                           Command="{Binding AutoScaleXCommand}">
                    <ui:Button.InputBindings>
                        <MouseBinding MouseAction="RightClick" Command="{Binding AutoAllAxesCommand}" CommandParameter="xy" />
                    </ui:Button.InputBindings>
                </ui:Button>
                <ui:Button Icon="{ui:SymbolIcon ArrowAutofitHeight24}"
                           ToolTip="Ajuster Y de tous les graphes sur la plage X visible, axes manuels compris (pour un seul graphe : clic droit sur ce graphe). Clic droit : tous les axes Y en automatique"
                           Command="{Binding AutoScaleYCommand}">
                    <ui:Button.InputBindings>
                        <MouseBinding MouseAction="RightClick" Command="{Binding AutoAllAxesCommand}" CommandParameter="y" />
                    </ui:Button.InputBindings>
                </ui:Button>
                <ui:Button Margin="8,2,0,2"
                           Icon="{ui:SymbolIcon ArrowUndo24}"
                           ToolTip="Annuler la dernière action (Ctrl+Z ou bouton « précédent » de la souris)"
                           Style="{StaticResource HistoryButton}"
                           Tag="{Binding CanUndoView}"
                           Command="{Binding UndoViewCommand}" />
                <ui:Button Margin="4,2,0,2"
                           Icon="{ui:SymbolIcon ArrowRedo24}"
                           ToolTip="Rétablir (Ctrl+Y ou bouton « suivant » de la souris)"
                           Style="{StaticResource HistoryButton}"
                           Tag="{Binding CanRedoView}"
                           Command="{Binding RedoViewCommand}" />
                <ui:Button Margin="12,2,0,2"
                           Content="Graphes"
                           Icon="{ui:SymbolIcon DataLine24}"
                           ToolTip="Titre et légende des graphes, axes Y automatiques ou manuels, alignement des zéros (aussi : clic droit sur un graphe)"
                           Command="{Binding EditAxesCommand}" />
                <ui:Button Margin="12,2,0,2"
                           Content="Calculs"
                           Icon="{ui:SymbolIcon MathFormula24}"
                           ToolTip="Courbes calculées (formules, moyennes, filtres, dérivée, intégrale) et spectre FFT"
                           Click="OnOpenButtonMenu">
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Nouvelle courbe calculée…"
                                      Icon="{ui:SymbolIcon MathFormula24}"
                                      Command="{Binding NewComputedCommand}" />
                            <MenuItem Header="Spectre (FFT)…"
                                      Icon="{ui:SymbolIcon DataHistogram24}"
                                      Command="{Binding ShowSpectrumCommand}" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
                <ToggleButton Margin="8,2,0,2"
                              Padding="11,5"
                              ToolTip="Deux curseurs X1 et X2 à faire glisser sur le graphe : valeurs, écart, min, max, moyenne et valeur efficace entre les deux (Ctrl+M)"
                              IsChecked="{Binding IsMeasuring}"
                              IsEnabled="{Binding HasData}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="Ruler24" />
                        <TextBlock VerticalAlignment="Center" Text="Mesures X" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Margin="4,2,0,2"
                              Padding="11,5"
                              ToolTip="Deux curseurs horizontaux Y1 et Y2 à faire glisser sur un graphe : niveaux et écart sur l'axe Y choisi (Ctrl+Maj+M)"
                              IsChecked="{Binding IsMeasuringY}"
                              IsEnabled="{Binding HasData}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="Ruler24" RenderTransformOrigin="0.5,0.5">
                            <ui:SymbolIcon.RenderTransform>
                                <RotateTransform Angle="90" />
                            </ui:SymbolIcon.RenderTransform>
                        </ui:SymbolIcon>
                        <TextBlock VerticalAlignment="Center" Text="Mesures Y" />
                    </StackPanel>
                </ToggleButton>
                <ui:Button Margin="8,2,0,2"
                           Icon="{ui:SymbolIcon Eraser24}"
                           ToolTip="Tout désélectionner (masquer toutes les courbes). Clic droit : réinitialiser la mise en page"
                           Command="{Binding ClearSelectionCommand}">
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Tout désélectionner"
                                      Icon="{ui:SymbolIcon Eraser24}"
                                      Command="{Binding ClearSelectionCommand}" />
                            <MenuItem Header="Réinitialiser la mise en page"
                                      ToolTip="Comme à la première ouverture du fichier : un graphe, aucune courbe, noms et styles d'origine, sans courbes calculées ni curseurs de mesure (Ctrl+Z pour annuler)"
                                      Icon="{ui:SymbolIcon ArrowReset24}"
                                      Command="{Binding ResetLayoutCommand}" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
            </WrapPanel>
        </DockPanel>
        <Grid x:Name="BodyGrid" Grid.Row="2" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CurveColumn" Width="330" MinWidth="200" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CursorRightColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Panneau gauche : courbes + curseur -->
            <Grid x:Name="LeftPanel" Grid.Column="0">
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
                </Grid.LayoutTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBox Grid.Row="0"
                            PlaceholderText="Rechercher une courbe…"
                            Icon="{ui:SymbolIcon Search24}"
                            ClearButtonEnabled="True"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <ListBox x:Name="CurveListBox"
                         Grid.Row="1"
                         Margin="0,8,0,0"
                         SelectionMode="Extended"
                         ToolTipService.InitialShowDelay="1500"
                         PreviewKeyDown="OnCurveListKeyDown"
                         PreviewMouseLeftButtonDown="OnCurvePreviewMouseDown"
                         PreviewMouseMove="OnCurvePreviewMouseMove"
                         ItemsSource="{Binding ChannelsView}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ToolTip>
                        <ToolTip>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="0,1,14,1" />
                                        <Setter Property="Foreground" Value="{DynamicResource AppMenuForeground}" />
                                    </Style>
                                </Grid.Resources>
                                <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Ctrl+clic" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="sélectionner plusieurs courbes" />
                                <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Maj+clic" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="sélectionner et cocher les courbes entre deux clics" />
                                <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Glisser" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="placer la sélection dans un graphe" />
                                <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Double-clic" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="réglages de la courbe" />
                                <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Clic droit" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="cocher, décocher, dupliquer ou supprimer la sélection" />
                                <TextBlock Grid.Row="5" FontWeight="SemiBold" Text="Suppr" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="supprimer les courbes calculées sélectionnées" />
                            </Grid>
                        </ToolTip>
                    </ListBox.ToolTip>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="6,2" />
                            <Setter Property="MinHeight" Value="30" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChannelItemViewModel}">
                            <!-- Tag carries the main view model to the context menu, which is outside the visual tree. -->
                            <Grid Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                <Grid.ContextMenu>
                                    <ContextMenu Opened="OnCurveMenuOpened">
                                        <MenuItem Header="Cocher la sélection"
                                                  Tag="tick"
                                                  Icon="{ui:SymbolIcon CheckboxChecked20}"
                                                  Click="OnTickSelection" />
                                        <MenuItem Header="Décocher la sélection"
                                                  Tag="untick"
                                                  Icon="{ui:SymbolIcon CheckboxUnchecked20}"
                                                  Click="OnTickSelection" />
                                        <Separator Tag="selection" />
                                        <MenuItem Header="Réglages de la courbe…"
                                                  Icon="{ui:SymbolIcon Edit20}"
                                                  Command="{Binding PlacementTarget.Tag.EditChannelCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Nouvelle courbe calculée à partir de celle-ci…"
                                                  Icon="{ui:SymbolIcon MathFormula24}"
                                                  Command="{Binding PlacementTarget.Tag.NewComputedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Dupliquer"
                                                  Tag="duplicate"
                                                  Icon="{ui:SymbolIcon Copy20}"
                                                  Click="OnDuplicateCurves" />
                                        <MenuItem Header="Modifier le calcul…"
                                                  Icon="{ui:SymbolIcon Edit20}"
                                                  Visibility="{Binding IsComputed, Converter={StaticResource BoolToVisibility}}"
                                                  Command="{Binding PlacementTarget.Tag.EditComputedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Supprimer la courbe calculée"
                                                  Tag="delete"
                                                  Icon="{ui:SymbolIcon Delete20}"
                                                  Click="OnDeleteCurves" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsPlotted}" MinHeight="0" Padding="6,0,0,0" ToolTip="{Binding Channel.SourceName}" Click="OnCurveCheckClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="12" Height="12" Margin="0,0,8,0" RadiusX="2" RadiusY="2"
                                                   VerticalAlignment="Center"
                                                   Fill="{Binding Brush}"
                                                   Visibility="{Binding IsPlotted, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Margin="0,0,5,0" VerticalAlignment="Center" FontStyle="Italic" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Text="ƒ"
                                                   ToolTip="Courbe calculée (clic droit pour modifier le calcul)"
                                                   Visibility="{Binding IsComputed, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}" Text="{Binding UnitLabel}" />
                                    </StackPanel>
                                </CheckBox>
                                <ui:Button x:Name="FormulaButton"
                                           Grid.Column="1"
                                           Padding="6,2"
                                           MinHeight="0"
                                           Appearance="Transparent"
                                           BorderThickness="0"
                                           ToolTip="Régler le calcul de la courbe (formule ou filtre)"
                                           Visibility="Collapsed"
                                           Command="{Binding DataContext.EditComputedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           CommandParameter="{Binding}">
                                    <TextBlock FontStyle="Italic" FontWeight="SemiBold" FontSize="13" Text="fx" />
                                </ui:Button>
                                <ui:Button x:Name="EditButton"
                                           Grid.Column="2"
                                           Padding="6,2"
                                           MinHeight="0"
                                           Appearance="Transparent"
                                           BorderThickness="0"
                                           Icon="{ui:SymbolIcon Edit20}"
                                           ToolTip="Réglages de la courbe : nom, unité, couleur, trait (ou clic droit)"
                                           Visibility="Hidden"
                                           Command="{Binding DataContext.EditChannelCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           CommandParameter="{Binding}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="EditButton" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <!-- fx: computed curves only; its room is kept (Hidden) so the names do not jump on hover -->
                                <DataTrigger Binding="{Binding IsComputed}" Value="True">
                                    <Setter TargetName="FormulaButton" Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsComputed}" Value="True" />
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="FormulaButton" Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Annotations : liste par ordre de création ; clic = y aller, double-clic = réglages, clic droit = menu -->
                <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,8" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Visibility="{Binding HasAnnotations, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <ui:Button DockPanel.Dock="Right" Padding="4" MinHeight="0"
                                       Appearance="Transparent" BorderThickness="0"
                                       Icon="{ui:SymbolIcon Delete16}"
                                       ToolTip="Supprimer toutes les annotations"
                                       Command="{Binding DeleteAllAnnotationsCommand}" />
                            <ui:Button DockPanel.Dock="Right" Padding="4" MinHeight="0"
                                       Appearance="Transparent" BorderThickness="0"
                                       Icon="{ui:SymbolIcon Eye16}"
                                       ToolTip="Masquer toutes les annotations sur le graphe (la liste les garde)"
                                       Visibility="{Binding ShowAnnotations, Converter={StaticResource BoolToVisibility}}"
                                       Command="{Binding ToggleShowAnnotationsCommand}" />
                            <ui:Button DockPanel.Dock="Right" Padding="4" MinHeight="0"
                                       Appearance="Transparent" BorderThickness="0"
                                       Icon="{ui:SymbolIcon EyeOff16}"
                                       ToolTip="Afficher les annotations sur le graphe"
                                       Visibility="{Binding AnnotationsHidden, Converter={StaticResource BoolToVisibility}}"
                                       Command="{Binding ToggleShowAnnotationsCommand}" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Annotations" />
                        </DockPanel>
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <!-- Right margin: the scroll bar is drawn over the content, not beside it. -->
                            <ItemsControl Margin="0,0,14,0" ItemsSource="{Binding Annotations}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AnnotationViewModel}">
                                        <!-- Tag carries the main view model to the context menu, which is outside the visual tree. -->
                                        <Grid Margin="0,2" Background="Transparent" Cursor="Hand"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              ToolTip="Clic : afficher cette annotation. Double-clic : réglages. Clic droit : menu"
                                              ToolTipService.InitialShowDelay="1200">
                                            <Grid.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.GoToAnnotationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}" />
                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                              Command="{Binding DataContext.EditAnnotationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}" />
                                            </Grid.InputBindings>
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Afficher dans le graphe"
                                                              Icon="{ui:SymbolIcon ZoomFit16}"
                                                              Command="{Binding PlacementTarget.Tag.GoToAnnotationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="Réglages de l'annotation…"
                                                              Icon="{ui:SymbolIcon Edit16}"
                                                              Command="{Binding PlacementTarget.Tag.EditAnnotationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="Mesurer cette zone (curseurs X1 et X2)"
                                                              Icon="{ui:SymbolIcon Ruler24}"
                                                              Visibility="{Binding IsZone, Converter={StaticResource BoolToVisibility}}"
                                                              Command="{Binding PlacementTarget.Tag.MeasureZoneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="Supprimer l'annotation"
                                                              Icon="{ui:SymbolIcon Delete16}"
                                                              Command="{Binding PlacementTarget.Tag.DeleteAnnotationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Width="10" Height="10" Margin="0,4,8,0" VerticalAlignment="Top" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding ListText}" />
                                                <TextBlock FontSize="11" Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis" Text="{Binding PositionText}" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" MinWidth="0" Margin="6,0,0,0" Padding="0" VerticalAlignment="Center"
                                                      ToolTip="Afficher ou masquer cette annotation"
                                                      IsChecked="{Binding IsVisible}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- The cursor card lives in one of three hosts (left, right, bottom): see MainWindow.PlaceCursorCard. -->
                <ContentControl x:Name="CursorHostLeft" Grid.Row="3" Margin="0,8,0,8" Focusable="False">
                    <Border x:Name="CursorCard"
                            Padding="12,10"
                            CornerRadius="6"
                            BorderThickness="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Curseur" />
                            <TextBlock DockPanel.Dock="Top" Margin="0,4,0,6" Foreground="{DynamicResource AppSecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding CursorXText}" />
                            <!-- Scrolls when many curves are plotted, so the card never hides the curve list. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl ItemsSource="{Binding CursorGroups}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="{Binding CursorGroupsOrientation}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CursorGroup}">
                                        <StackPanel Width="{Binding DataContext.CursorGroupWidth, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                    Margin="0,0,20,8">
                                            <TextBlock Margin="0,0,0,2" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                       Text="{Binding Graph.Title}"
                                                       Visibility="{Binding ShowTitle, Converter={StaticResource BoolToVisibility}}" />
                                            <ItemsControl ItemsSource="{Binding Curves}"
                                                          Cursor="SizeAll"
                                                          ToolTip="Faites glisser une courbe vers un autre graphe"
                                                          PreviewMouseLeftButtonDown="OnCurvePreviewMouseDown"
                                                          PreviewMouseMove="OnCurvePreviewMouseMove">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ChannelItemViewModel}">
                                                        <Grid Margin="0,2" Background="Transparent">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle Width="10" Height="10" Margin="0,0,8,0" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" />
                                                            <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip="{Binding Name}" />
                                                            <!-- Fixed minimum width, right-aligned: the card does not jump when the digits change. -->
                                                            <TextBlock Grid.Column="2" Margin="10,0,0,0" MinWidth="120" TextAlignment="Right"
                                                                       FontFamily="Consolas" Text="{Binding CursorText}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ContentControl>
            </Grid>

            <GridSplitter x:Name="CurveSplitter" Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Graphe (+ emplacement du curseur sous le graphe) -->
            <Grid x:Name="PlotColumn" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="0,0,0,8" CornerRadius="6" ClipToBounds="True">
                <Grid AllowDrop="True"
                      DragEnter="OnPlotDragOver"
                      DragOver="OnPlotDragOver"
                      DragLeave="OnPlotDragLeave"
                      Drop="OnPlotDrop">
                    <scottplot:WpfPlot x:Name="PlotView">
                        <scottplot:WpfPlot.Style>
                            <Style TargetType="scottplot:WpfPlot">
                                <Style.Triggers>
                                    <!-- No empty axes before a file is open: the drop zone takes the place. -->
                                    <DataTrigger Binding="{Binding HasData}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </scottplot:WpfPlot.Style>
                    </scottplot:WpfPlot>

                    <!-- Startup: drop zone for a CSV file (click = open dialog) -->
                    <Grid x:Name="FileDropZone"
                          Background="Transparent"
                          Cursor="Hand"
                          MouseLeftButtonUp="OnFileDropZoneClick"
                          Visibility="{Binding ShowFileDropZone, Converter={StaticResource BoolToVisibility}}">
                        <Rectangle x:Name="FileDropFrame" Margin="24" RadiusX="14" RadiusY="14"
                                   StrokeThickness="2" StrokeDashArray="6 4"
                                   Stroke="{DynamicResource AppSecondaryTextBrush}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon HorizontalAlignment="Center" Symbol="DocumentAdd24" FontSize="64"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold"
                                       Text="Glissez un fichier CSV ici" />
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="14"
                                       Foreground="{DynamicResource AppSecondaryTextBrush}"
                                       Text="ou cliquez pour en choisir un (Ctrl+O)" />
                            <!-- Fichiers récents (a click on one does not reach the drop zone: the button handles it) -->
                            <StackPanel Margin="40,28,40,0" HorizontalAlignment="Center"
                                        Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Fichiers récents" />
                                <ItemsControl ItemsSource="{Binding StartRecentFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:RecentFile}">
                                            <ui:Button Margin="0,0,0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                       Appearance="Transparent" Cursor="Hand"
                                                       ToolTip="{Binding Path}"
                                                       Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding Path}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource AppSecondaryTextBrush}" TextTrimming="CharacterEllipsis"
                                                               MaxWidth="460" Text="{Binding Folder}" />
                                                </StackPanel>
                                            </ui:Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Drop targets, shown while a curve is dragged -->
                    <Canvas IsHitTestVisible="False">
                        <Border x:Name="DropHighlight" Visibility="Collapsed" CornerRadius="4" BorderThickness="2"
                                BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    </Canvas>
                    <Border x:Name="NewGraphZone"
                            Height="44"
                            Margin="8,0,8,8"
                            VerticalAlignment="Bottom"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            CornerRadius="6"
                            BorderThickness="2"
                            BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Background="{DynamicResource ApplicationBackgroundBrush}">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   Text="＋ Nouveau graphe" />
                    </Border>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Opacity="0.6"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="{Binding PlotHint}"
                               Visibility="{Binding ShowPlotHint, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
                <!-- Mesures : curseurs X1 et X2 (axe X), Y1 et Y2 (axe Y) -->
                <Border Grid.Row="1" Margin="0,0,0,8" Padding="12,8" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Visibility="{Binding ShowMeasurePanel, Converter={StaticResource BoolToVisibility}}">
                    <Border.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
                    </Border.LayoutTransform>
                    <Border.Resources>
                        <Style x:Key="MeasureCell" TargetType="TextBlock">
                            <Setter Property="Margin" Value="14,0,0,0" />
                            <Setter Property="TextAlignment" Value="Right" />
                            <Setter Property="FontFamily" Value="Consolas" />
                        </Style>
                        <Style x:Key="MeasureHead" TargetType="TextBlock">
                            <Setter Property="Margin" Value="14,0,0,2" />
                            <Setter Property="TextAlignment" Value="Right" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
                        </Style>
                    </Border.Resources>
                    <DockPanel Grid.IsSharedSizeScope="True">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6"
                                   Visibility="{Binding IsMeasuringY, Converter={StaticResource BoolToVisibility}}">
                            <ui:Button DockPanel.Dock="Right" Padding="4" MinHeight="0"
                                       Appearance="Transparent" BorderThickness="0"
                                       Icon="{ui:SymbolIcon Dismiss16}"
                                       ToolTip="Masquer les curseurs Y1 et Y2 (Ctrl+Maj+M)"
                                       Command="{Binding ToggleMeasureYCommand}" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Mesures entre Y1 et Y2" />
                            <ComboBox Margin="12,0,0,0" MinWidth="220" HorizontalAlignment="Left" VerticalAlignment="Center"
                                      ToolTip="L'axe Y sur lequel Y1 et Y2 sont mesurés (aussi : clic droit sur un graphe, « Placer le curseur Y1 ici »)"
                                      ItemsSource="{Binding MeasureYAxisChoices}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"
                                      SelectedValue="{Binding MeasureYAxisId}" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontFamily="Consolas" TextWrapping="Wrap"
                                   Text="{Binding MeasureYSummary}"
                                   Visibility="{Binding IsMeasuringY, Converter={StaticResource BoolToVisibility}}" />
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6"
                                   Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVisibility}}">
                            <ui:Button DockPanel.Dock="Right" Padding="4" MinHeight="0"
                                       Appearance="Transparent" BorderThickness="0"
                                       Icon="{ui:SymbolIcon Dismiss16}"
                                       ToolTip="Masquer les curseurs X1 et X2 (Ctrl+M)"
                                       Command="{Binding ToggleMeasureCommand}" />
                            <ui:Button DockPanel.Dock="Right" Margin="0,0,6,0" Padding="8,3" MinHeight="0"
                                       Icon="{ui:SymbolIcon Highlight16}"
                                       Content="Zone X1–X2"
                                       ToolTip="Créer une zone surlignée entre les curseurs X1 et X2 (annotation)"
                                       Command="{Binding ZoneFromMeasureCommand}" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Mesures entre X1 et X2" />
                            <TextBlock Margin="16,0,8,0" VerticalAlignment="Center" FontFamily="Consolas"
                                       Foreground="{DynamicResource AppSecondaryTextBrush}"
                                       TextWrapping="Wrap" Text="{Binding MeasureSummary}" />
                        </DockPanel>
                        <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MName" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="M1" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="M2" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="M3" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="M4" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="M5" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="M6" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="M7" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="M8" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" MinWidth="160" Margin="0,0,0,2" FontWeight="SemiBold" Foreground="{DynamicResource AppSecondaryTextBrush}" Text="Courbe" />
                            <TextBlock Grid.Column="1" MinWidth="70" Style="{StaticResource MeasureHead}" Foreground="#D6336C" Text="X1" />
                            <TextBlock Grid.Column="2" MinWidth="70" Style="{StaticResource MeasureHead}" Foreground="#0C8599" Text="X2" />
                            <TextBlock Grid.Column="3" MinWidth="70" Style="{StaticResource MeasureHead}" Text="X2 − X1" />
                            <TextBlock Grid.Column="4" MinWidth="70" Style="{StaticResource MeasureHead}" Text="Min" />
                            <TextBlock Grid.Column="5" MinWidth="70" Style="{StaticResource MeasureHead}" Text="Max" />
                            <TextBlock Grid.Column="6" MinWidth="70" Style="{StaticResource MeasureHead}" Text="Moyenne" />
                            <TextBlock Grid.Column="7" MinWidth="70" Style="{StaticResource MeasureHead}" Text="RMS" ToolTip="Valeur efficace (RMS)" />
                            <TextBlock Grid.Column="8" MinWidth="70" Style="{StaticResource MeasureHead}" Text="Crête-crête" />
                        </Grid>
                            <ItemsControl ItemsSource="{Binding MeasureRows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MeasureRow}">
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MName" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="M1" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="M2" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="M3" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="M4" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="M5" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="M6" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="M7" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="M8" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" MaxWidth="260" Orientation="Horizontal">
                                                <Rectangle Width="10" Height="10" Margin="0,0,8,0" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" />
                                                <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip="{Binding Name}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Style="{StaticResource MeasureCell}" Text="{Binding A}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource MeasureCell}" Text="{Binding B}" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource MeasureCell}" Text="{Binding Delta}" />
                                            <TextBlock Grid.Column="4" Style="{StaticResource MeasureCell}" Text="{Binding Min}" />
                                            <TextBlock Grid.Column="5" Style="{StaticResource MeasureCell}" Text="{Binding Max}" />
                                            <TextBlock Grid.Column="6" Style="{StaticResource MeasureCell}" Text="{Binding Mean}" />
                                            <TextBlock Grid.Column="7" Style="{StaticResource MeasureCell}" Text="{Binding Rms}" />
                                            <TextBlock Grid.Column="8" Style="{StaticResource MeasureCell}" Text="{Binding PeakToPeak}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <ContentControl x:Name="CursorHostBottom" Grid.Row="2" Margin="0,0,0,8" Focusable="False" Visibility="Collapsed">
                    <ContentControl.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
                    </ContentControl.LayoutTransform>
                </ContentControl>
            </Grid>

            <ContentControl x:Name="CursorHostRight" Grid.Column="3" Margin="8,0,0,8" MaxWidth="340"
                            VerticalAlignment="Top" Focusable="False" Visibility="Collapsed">
                <ContentControl.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
                </ContentControl.LayoutTransform>
            </ContentControl>
        </Grid>

        <!-- Barre d'état -->
        <Grid Grid.Row="3" Margin="12,0,12,8">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
            </Grid.LayoutTransform>
            <TextBlock Margin="0,0,260,0" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}" />
            <ProgressBar Width="240"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Value="{Binding LoadProgress}"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
