<ui:FluentWindow x:Class="CsvAnalyser.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
                 xmlns:vm="clr-namespace:CsvAnalyser.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="{Binding Title}"
                 Width="1400" Height="860" MinWidth="900" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowCornerPreference="Round"
                 Icon="Assets/app.ico"
                 AllowDrop="True"
                 DragOver="OnDragOver"
                 Drop="OnDrop">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-64.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Barre d'outils -->
        <DockPanel Grid.Row="1" Margin="12,4,12,10" LastChildFill="False">
            <ui:Button DockPanel.Dock="Left"
                       Appearance="Primary"
                       Content="Ouvrir…"
                       Icon="{ui:SymbolIcon FolderOpen24}"
                       Command="{Binding OpenCommand}" />
            <TextBlock DockPanel.Dock="Left" Margin="20,0,8,0" VerticalAlignment="Center" Text="Axe X" />
            <ComboBox DockPanel.Dock="Left"
                      Width="280"
                      ItemsSource="{Binding XAxisOptions}"
                      SelectedItem="{Binding SelectedXAxis}"
                      IsEnabled="{Binding HasData}" />
            <ui:Button DockPanel.Dock="Left"
                       Margin="12,0,0,0"
                       Content="Ajuster"
                       Icon="{ui:SymbolIcon ArrowMaximize24}"
                       ToolTip="Recadrer sur l'ensemble des données"
                       Command="{Binding AutoScaleCommand}" />
            <ui:Button DockPanel.Dock="Left"
                       Margin="8,0,0,0"
                       Content="Tout désélectionner"
                       Icon="{ui:SymbolIcon Eraser24}"
                       Command="{Binding ClearSelectionCommand}" />

            <ComboBox DockPanel.Dock="Right"
                      Width="170"
                      ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding SelectedTheme}" />
            <TextBlock DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center" Text="Thème" />
        </DockPanel>

        <Grid Grid.Row="2" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="200" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Panneau gauche : courbes + curseur -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBox Grid.Row="0"
                            PlaceholderText="Rechercher une courbe…"
                            Icon="{ui:SymbolIcon Search24}"
                            ClearButtonEnabled="True"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <ListBox Grid.Row="1"
                         Margin="0,8,0,0"
                         ItemsSource="{Binding ChannelsView}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="6,2" />
                            <Setter Property="MinHeight" Value="30" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChannelItemViewModel}">
                            <CheckBox IsChecked="{Binding IsPlotted}" MinHeight="0" Padding="6,0,0,0" ToolTip="{Binding Channel.SourceName}">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="12" Height="12" Margin="0,0,8,0" RadiusX="2" RadiusY="2"
                                               VerticalAlignment="Center"
                                               Fill="{Binding Brush}"
                                               Visibility="{Binding IsPlotted, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}" Text="{Binding UnitLabel}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2"
                        Margin="0,8,0,8"
                        Padding="12,10"
                        CornerRadius="6"
                        BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Curseur" />
                        <TextBlock Margin="0,4,0,6" Foreground="{DynamicResource AppSecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding CursorXText}" />
                        <ItemsControl ItemsSource="{Binding PlottedChannels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChannelItemViewModel}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Width="10" Height="10" Margin="0,0,8,0" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" />
                                        <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip="{Binding Name}" />
                                        <TextBlock Grid.Column="2" Margin="10,0,0,0" FontFamily="Consolas" Text="{Binding CursorText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Graphe -->
            <Border Grid.Column="2" Margin="0,0,0,8" CornerRadius="6" ClipToBounds="True">
                <Grid>
                    <scottplot:WpfPlot x:Name="PlotView" />
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Opacity="0.6"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="{Binding PlotHint}"
                               Visibility="{Binding ShowPlotHint, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Barre d'état -->
        <Grid Grid.Row="3" Margin="12,0,12,8">
            <TextBlock Margin="0,0,260,0" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}" />
            <ProgressBar Width="240"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Value="{Binding LoadProgress}"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
