<ui:FluentWindow x:Class="CsvAnalyser.App.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:CsvAnalyser.App.Controls"
                 xmlns:vm="clr-namespace:CsvAnalyser.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="Paramètres"
                 Width="500"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 controls:UiScaling.ScaleWindow="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowCornerPreference="Round">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Paramètres" ShowMinimize="False" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" MaxHeight="660" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,4,24,0">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Affichage" />
            <TextBlock Margin="0,2,0,16" Foreground="{DynamicResource AppSecondaryTextBrush}"
                       Text="Les changements s'appliquent tout de suite et sont mémorisés." />

            <TextBlock FontWeight="SemiBold" Text="Langue" />
            <ComboBox Margin="0,6,0,4"
                      ItemsSource="{Binding AvailableLanguages}"
                      SelectedValuePath="Code"
                      DisplayMemberPath="Name"
                      SelectedValue="{Binding LanguageCode}" />
            <DockPanel Margin="0,0,0,16" Visibility="{Binding LanguageRestartNeeded, Converter={StaticResource BoolToVisibility}}">
                <ui:Button DockPanel.Dock="Right" Content="Redémarrer maintenant" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRestart" />
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}" TextWrapping="Wrap"
                           Text="La langue s'applique au prochain démarrage." />
            </DockPanel>

            <TextBlock FontWeight="SemiBold" Text="Thème du graphe" />
            <ComboBox Margin="0,6,0,20"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding SelectedTheme}" />

            <!-- Grille de fond -->
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Padding="8,3" MinHeight="0" Content="Par défaut"
                           Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetGridCommand}" />
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Grille de fond" />
            </DockPanel>
            <UniformGrid Margin="0,6,0,0" Columns="2">
                <CheckBox Margin="0,0,0,4" Content="Lignes verticales" IsChecked="{Binding GridVertical}" />
                <CheckBox Margin="0,0,0,4" Content="Lignes horizontales" IsChecked="{Binding GridHorizontal}" />
                <CheckBox Margin="0,0,0,4" Content="Lignes secondaires" ToolTip="Lignes fines entre les graduations" IsChecked="{Binding GridMinor}" />
                <CheckBox Margin="0,0,0,4" Content="Bandes alternées" ToolTip="Une bande sur deux légèrement colorée, entre les lignes horizontales" IsChecked="{Binding GridBands}" />
            </UniformGrid>
            <Grid Margin="0,6,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Style" />
                    <ComboBox Margin="0,4,0,0"
                              ItemsSource="{x:Static vm:MainViewModel.GridPatternChoices}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              SelectedValue="{Binding GridPattern}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" FontFamily="Consolas" Text="{Binding GridIntensity, StringFormat={}{0:P0}}" />
                        <TextBlock Text="Intensité" />
                    </DockPanel>
                    <Slider Margin="0,8,0,0" Minimum="0.03" Maximum="0.8" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding GridIntensity}"
                            ToolTip="De très pâle à aussi foncé que les axes" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" FontFamily="Consolas" Text="{Binding GridWidth, StringFormat={}{0:0.0}}" />
                        <TextBlock Text="Épaisseur" />
                    </DockPanel>
                    <Slider Margin="0,8,0,0" Minimum="0.5" Maximum="4" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding GridWidth}" />
                </StackPanel>
            </Grid>

            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontFamily="Consolas" VerticalAlignment="Bottom"
                           Text="{Binding UiScale, StringFormat={}{0:P0}}" />
                <TextBlock FontWeight="SemiBold" Text="Taille de l'interface" />
            </DockPanel>
            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource AppSecondaryTextBrush}"
                       Text="Barre d'outils, liste des courbes et barre d'état." />
            <Slider Margin="0,6,0,20"
                    Minimum="{x:Static vm:MainViewModel.MinUiScale}"
                    Maximum="{x:Static vm:MainViewModel.MaxUiScale}"
                    TickFrequency="0.05"
                    IsSnapToTickEnabled="True"
                    Value="{Binding UiScale}" />

            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontFamily="Consolas" VerticalAlignment="Bottom"
                           Text="{Binding PlotFontScale, StringFormat={}{0:P0}}" />
                <TextBlock FontWeight="SemiBold" Text="Taille des textes du graphe" />
            </DockPanel>
            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource AppSecondaryTextBrush}"
                       Text="Graduations, titres des axes et légende." />
            <Slider Margin="0,6,0,8"
                    Minimum="{x:Static vm:MainViewModel.MinPlotFontScale}"
                    Maximum="{x:Static vm:MainViewModel.MaxPlotFontScale}"
                    TickFrequency="0.1"
                    IsSnapToTickEnabled="True"
                    Value="{Binding PlotFontScale}" />

            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Placement du panneau curseur" />
            <ComboBox Margin="0,6,0,8"
                      ItemsSource="{x:Static vm:MainViewModel.CursorPanelChoices}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="Label"
                      SelectedValue="{Binding CursorPanelPlacement}" />
            <CheckBox Margin="0,4,0,8"
                      Content="Afficher les valeurs du curseur dans les graphiques"
                      ToolTip="Chaque valeur est écrite à côté de son point d'intersection avec le curseur"
                      IsChecked="{Binding ShowCursorLabels}" />

            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Choix des actions souris" />
            <ComboBox Margin="0,6,0,8"
                      ItemsSource="{x:Static vm:MainViewModel.MouseChoices}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="Label"
                      SelectedValue="{Binding LeftDragZooms}" />

            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Résolution des images copiées ou enregistrées" />
            <ComboBox Margin="0,6,0,8"
                      ItemsSource="{x:Static vm:MainViewModel.ImageScaleChoices}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="Label"
                      SelectedValue="{Binding ImageScale}" />

            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Fichiers" />
            <CheckBox Margin="0,6,0,8"
                      Content="Retrouver la mise en page en rouvrant un fichier"
                      ToolTip="Graphes, courbes, réglages et zoom de chaque fichier sont mémorisés quand on le quitte"
                      IsChecked="{Binding RestoreLayout}" />

            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Version et mises à jour" />
            <DockPanel Margin="0,6,0,0">
                <ui:Button DockPanel.Dock="Right"
                           Content="Rechercher une mise à jour"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           ToolTip="Consulte les versions publiées sur GitHub (pas encore prise en charge)"
                           Command="{Binding CheckForUpdatesCommand}" />
                <TextBlock VerticalAlignment="Center" FontFamily="Consolas" Text="{Binding AppVersionText}" />
            </DockPanel>
            <CheckBox Margin="0,8,0,8"
                      Content="Rechercher les mises à jour au démarrage"
                      ToolTip="Une nouvelle version est signalée dans la barre d'état (pas encore prise en charge)"
                      IsChecked="{Binding CheckUpdatesAtStartup}" />

            <!-- Auteur : tout en bas, discret (un filet fin au-dessus, texte centré) -->
            <Border Margin="0,20,0,4" Padding="0,8,0,0" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource AppDisabledTextBrush}">
                <TextBlock HorizontalAlignment="Center" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource AppSecondaryTextBrush}"
                           Text="CSV Analyser, développé par Rodolphe Giammatteo." />
            </Border>
        </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="24,16,24,20" LastChildFill="False">
            <ui:Button DockPanel.Dock="Left"
                       Content="Tailles par défaut"
                       Icon="{ui:SymbolIcon ArrowReset24}"
                       Command="{Binding ResetDisplaySizesCommand}" />
            <ui:Button DockPanel.Dock="Right"
                       MinWidth="100"
                       Appearance="Primary"
                       Content="Fermer"
                       IsCancel="True"
                       IsDefault="True"
                       Click="OnClose" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
