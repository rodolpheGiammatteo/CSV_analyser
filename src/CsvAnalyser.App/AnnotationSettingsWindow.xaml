<ui:FluentWindow x:Class="CsvAnalyser.App.AnnotationSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:CsvAnalyser.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:AnnotationViewModel}"
                 Title="Réglages de l'annotation"
                 Width="460"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <!-- Color swatch: a plain colored square, outlined on hover (as in the curve settings). -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="5" BorderThickness="1" Padding="2"
                                BorderBrush="{DynamicResource AppDisabledTextBrush}">
                            <Border CornerRadius="3" Background="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Frame" Property="Padding" Value="1" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AppSecondaryTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Réglages de l'annotation" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,0">
            <!-- En-tête : couleur + type et position -->
            <DockPanel Margin="0,0,0,16">
                <Border DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center"
                        CornerRadius="4" Background="{Binding Brush}" />
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}"
                           TextWrapping="Wrap" Text="{Binding PositionText}" />
            </DockPanel>

            <!-- Texte -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Texte" />
            <ui:TextBox x:Name="TextField" Margin="0,0,0,18" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Delay=300}" />

            <!-- Couleur -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Couleur" />
            <ItemsControl ItemsSource="{x:Static vm:AnnotationViewModel.Swatches}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Swatch}"
                                Background="{Binding}"
                                ToolTip="{Binding}"
                                Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Margin="0,4,0,18" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Code" />
                <ui:TextBox Width="110" FontFamily="Consolas"
                            ToolTip="Couleur en hexadécimal, par exemple #1F77B4 (Entrée pour valider)"
                            Text="{Binding ColorHex}" KeyDown="OnHexKeyDown" />
            </StackPanel>

            <!-- Taille du texte -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontFamily="Consolas" Text="{Binding FontSize, StringFormat={}{0:0}}" />
                <TextBlock FontWeight="SemiBold" Text="Taille du texte" />
            </DockPanel>
            <Slider Margin="0,0,0,14" Minimum="7" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize}" />

            <!-- Trait -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Trait" />
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          ItemsSource="{x:Static vm:AnnotationViewModel.Lines}"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding Line}"
                          Visibility="{Binding HasLine, Converter={StaticResource BoolToVisibility}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Line X1="0" Y1="0" X2="32" Y2="0" Margin="0,0,10,0" VerticalAlignment="Center"
                                      StrokeThickness="2" Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                      StrokeDashArray="{Binding Dash}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Grid.Column="2">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" FontFamily="Consolas" Text="{Binding LineWidth, StringFormat={}{0:0.0}}" />
                        <TextBlock Text="Épaisseur" />
                    </DockPanel>
                    <Slider Minimum="0.5" Maximum="8" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding LineWidth}" />
                </StackPanel>
            </Grid>

            <!-- Opacité de la zone -->
            <StackPanel Visibility="{Binding IsZone, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" FontFamily="Consolas" Text="{Binding Opacity, StringFormat={}{0:P0}}" />
                    <TextBlock FontWeight="SemiBold" Text="Opacité de la zone" />
                </DockPanel>
                <Slider Margin="0,0,0,14" Minimum="0.02" Maximum="0.9" TickFrequency="0.02" IsSnapToTickEnabled="True" Value="{Binding Opacity}" />
            </StackPanel>

            <!-- Graphe -->
            <StackPanel Visibility="{Binding CanChooseGraph, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Afficher sur" />
                <ComboBox Margin="0,0,0,14" DisplayMemberPath="Label"
                          ItemsSource="{Binding GraphChoices}"
                          SelectedItem="{Binding GraphChoice}" />
            </StackPanel>

            <CheckBox Content="Visible" IsChecked="{Binding IsVisible}"
                      ToolTip="Une annotation masquée reste dans la liste des annotations" />
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="24,20,24,20" LastChildFill="False">
            <ui:Button DockPanel.Dock="Left"
                       Content="Supprimer"
                       Icon="{ui:SymbolIcon Delete24}"
                       ToolTip="Supprimer cette annotation (Ctrl+Z pour annuler)"
                       Click="OnDelete" />
            <ui:Button DockPanel.Dock="Right"
                       MinWidth="100"
                       Appearance="Primary"
                       Content="Fermer"
                       IsCancel="True"
                       Click="OnClose" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
