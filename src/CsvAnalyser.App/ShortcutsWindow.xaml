<ui:FluentWindow x:Class="CsvAnalyser.App.ShortcutsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:CsvAnalyser.App.Controls"
                 Title="Raccourcis clavier"
                 Width="640"
                 Height="680"
                 MinWidth="480"
                 MinHeight="360"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 controls:UiScaling.ScaleWindow="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <Style x:Key="GestureBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="Width" Value="170" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Raccourcis clavier" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,8">
            <ui:TextBox x:Name="SearchBox"
                        PlaceholderText="Rechercher une action…"
                        Icon="{ui:SymbolIcon Search24}"
                        ClearButtonEnabled="True"
                        TextChanged="OnSearchChanged" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}"
                       Text="Cliquez dans une case puis appuyez sur la combinaison voulue (Ctrl, Alt, Maj + une touche, ou F1 à F12 seules). Suppr ou Retour arrière : effacer. « Courbe active » : la courbe sous la souris dans un graphe, sinon la dernière cliquée dans la liste ou le volet curseur." />
            <TextBlock x:Name="Message" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#D13438" Visibility="Collapsed" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="24,0,8,0" Padding="0,0,16,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ActionList">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="{Binding Items[0].CategoryText}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" Text="{Binding NameText}" />
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource GestureBox}"
                                     Text="{Binding DisplayText, Mode=OneWay}"
                                     ToolTip="Cliquez puis appuyez sur la combinaison de touches"
                                     PreviewKeyDown="OnGestureKeyDown"
                                     GotKeyboardFocus="OnGestureFocus"
                                     LostKeyboardFocus="OnGestureBlur" />
                            <ui:Button Grid.Column="2" Margin="6,0,0,0" Padding="6"
                                       Icon="{ui:SymbolIcon Dismiss20}"
                                       ToolTip="Pas de raccourci"
                                       Click="OnClearGesture" />
                            <ui:Button Grid.Column="3" Margin="4,0,0,0" Padding="6"
                                       Icon="{ui:SymbolIcon ArrowReset20}"
                                       ToolTip="Raccourci d'origine"
                                       Click="OnDefaultGesture" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="24,16,24,20" LastChildFill="False">
            <ui:Button DockPanel.Dock="Left"
                       Content="Tout réinitialiser"
                       Icon="{ui:SymbolIcon ArrowReset24}"
                       ToolTip="Revenir aux raccourcis d'origine pour toutes les actions"
                       Click="OnResetAll" />
            <ui:Button DockPanel.Dock="Right"
                       MinWidth="110"
                       Margin="8,0,0,0"
                       Appearance="Primary"
                       Content="Enregistrer"
                       Click="OnSave" />
            <ui:Button DockPanel.Dock="Right"
                       MinWidth="100"
                       Content="Annuler"
                       IsCancel="True"
                       Click="OnCancel" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
