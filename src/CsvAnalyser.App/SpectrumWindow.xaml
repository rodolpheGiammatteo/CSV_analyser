<ui:FluentWindow x:Class="CsvAnalyser.App.SpectrumWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
                 Title="Spectre (FFT)"
                 Width="1000"
                 Height="680"
                 MinWidth="640"
                 MinHeight="420"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowCornerPreference="Round">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Spectre (FFT)" />

        <WrapPanel Grid.Row="1" Margin="16,0,16,6">
            <StackPanel Margin="0,2,20,2" Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Plage" />
                <ComboBox x:Name="RangeCombo" MinWidth="230" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectionChanged="OnOptionChanged" />
            </StackPanel>
            <StackPanel Margin="0,2,20,2" Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Fenêtre" />
                <ComboBox x:Name="WindowCombo" MinWidth="230" DisplayMemberPath="Label" SelectedValuePath="Value"
                          ToolTip="Hann : usage général. Flat top : amplitudes exactes, pics plus larges. Rectangulaire : aucune pondération (signal périodique sur la plage)."
                          SelectionChanged="OnOptionChanged" />
            </StackPanel>
            <CheckBox x:Name="DecibelBox" Margin="0,2,20,2" Content="Amplitude en dB"
                      ToolTip="20 × log10(amplitude) : les petits pics deviennent visibles"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
            <CheckBox x:Name="RemoveMeanBox" Margin="0,2,0,2" Content="Retirer la moyenne" IsChecked="True"
                      ToolTip="Sans la valeur moyenne, le pic à 0 Hz n'écrase pas le reste du spectre"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
        </WrapPanel>

        <DockPanel Grid.Row="2" Margin="16,0,16,6">
            <TextBlock DockPanel.Dock="Left" Margin="0,4,12,0" VerticalAlignment="Top" Text="Courbes" />
            <ItemsControl x:Name="CurveList" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DockPanel>

        <Grid Grid.Row="3" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border CornerRadius="6" ClipToBounds="True">
                <scottplot:WpfPlot x:Name="PlotView" />
            </Border>
            <!-- Les 5 pics principaux de chaque courbe (remplis par le code) -->
            <DockPanel Grid.Column="1" Width="250" Margin="12,0,0,0">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Pics principaux" />
                <TextBlock x:Name="PeaksUnitText" DockPanel.Dock="Top" Margin="0,0,0,4" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PeaksPanel" />
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <DockPanel Grid.Row="4" Margin="16,0,16,10">
            <TextBlock x:Name="MouseText" DockPanel.Dock="Right" FontFamily="Consolas"
                       Foreground="{DynamicResource AppSecondaryTextBrush}" />
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource AppSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
